# Auth0 OAuth Configuration
# Copy this file to .env and fill in your Auth0 credentials
#
# The .env file is automatically loaded by the web server on startup.
# You don't need to manually export these variables.

# Your Auth0 domain (e.g., myapp.us.auth0.com or myapp.eu.auth0.com)
AUTH0_DOMAIN=your-domain.auth0.com

# OAuth Client ID from Auth0 Application settings
AUTH0_CLIENT_ID=your_client_id_here

# OAuth Client Secret from Auth0 Application settings
AUTH0_CLIENT_SECRET=your_client_secret_here

# Callback URL - must match what's registered in Auth0
# For local development:
AUTH0_CALLBACK_URL=http://localhost:8080/auth/callback

# OAuth scopes (space-separated)
AUTH0_SCOPE=openid profile email

# Optional: Logout redirect URL (where to go after Auth0 logout)
# Must be in "Allowed Logout URLs" in Auth0 Application settings
AUTH0_LOGOUT_REDIRECT=http://localhost:8080/

# Optional: API Audience (if using Auth0 APIs)
# AUTH0_AUDIENCE=https://your-api.example.com
